#include <msp430.h>
#include "halGpio.h"

void halGpioInit(void)
{
    // --- PORT 1 ---
    // BIT0 - BIT2: Unbenutzte Pins als Ausgang (Low)
    // BIT3 - BIT5: Sensoren (Eingänge)
    // BIT6 - BIT7: Start- und Stoptaste (Eingänge mit Pull-Up)
    P1DIR = BIT0 | BIT1 | BIT2;
    P1OUT = START_BUTTON | STOP_BUTTON; // Pull-Up-Pegel setzen (High)
    P1REN = START_BUTTON | STOP_BUTTON; // Pull-Widerstand aktivieren

    // --- PORT 2 ---
    // DEBUG_TXD & AUX-Pins als Ausgänge, Rest als Eingänge/Peripherie
    P2DIR = AUX_PIN_1 | AUX_PIN_2 | AUX_PIN_3 | AUX_PIN_4 | DEBUG_TXD;
    P2OUT = 0x00;
    P2REN = 0x00;

    // --- PORT 3 ---
    // THROTTLE, STEERING, SMCLK, DISTANCE_FRONT_EN als Ausgänge
    // Unbenutzte Pins (BIT0, BIT1, BIT5, BIT6) als Ausgänge Low
    P3DIR = BIT0 | BIT1 | BIT5 | BIT6 | THROTTLE | STEERING | SMCLK | DISTANCE_FRONT_EN;
    P3OUT = 0x00;

    // --- PORT 4 ---
    // Line Follower (BIT3 - BIT7) als Eingänge
    // BIT0 - BIT2 als unbenutzte Ausgänge Low
    P4DIR = BIT0 | BIT1 | BIT2;
    P4OUT = 0x00;

    // --- PORT 6 ---
    // Abstandssensoren & VBAT als Eingänge (BIT0 - BIT3)
    // DISTANCE_LEFT_EN (BIT4) als Ausgang
    // BIT5 - BIT7 als unbenutzte Ausgänge Low
    P6DIR = BIT5 | BIT6 | BIT7 | DISTANCE_LEFT_EN;
    P6OUT = 0x00;

    // --- PORT 7 ---
    // Port 7 komplett als Ausgang Low konfigurieren
    P7DIR = 0xFF;
    P7OUT = 0x00;

    // --- PORT 8 ---
    // LCD-Steuerung & UART Aux (Ausgänge, außer RXD_AUX als Eingang)
    P8DIR = LCD_BL | LCD_SPI_CS | UART_TXD_AUX | LCD_SPI_CLK | LCD_SPI_MOSI | LCD_DATACMD;
    P8OUT = 0x00;

    // --- PORT 9 ---
    // LCD_RESET (BIT0) & DISTANCE_RIGHT_EN (BIT7) als Ausgänge
    // Zwischenliegende unbenutzte Pins (BIT1 - BIT6) als Ausgänge Low
    P9DIR = BIT1 | BIT2 | BIT3 | BIT4 | BIT5 | BIT6 | LCD_RESET | DISTANCE_RIGHT_EN;
    P9OUT = 0x00;
}
